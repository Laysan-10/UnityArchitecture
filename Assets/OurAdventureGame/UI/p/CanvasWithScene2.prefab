      m_Calls: []
  m_text: "\u0414\u043E\u0431\u043B\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u044B\u0446\u0430\u0440\u044C,
    \u043D\u0430 \u0442\u0432\u043E\u0451\u043C \u043F\u0443\u0442\u0438 \u043A \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E
    \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430 \u0442\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u0442\u043E\u043B\u043A\u043D\u0435\u0448\u044C\u0441\u044F \u0441 \u0432\u0440\u0430\u0433\u043E\u043C.
    \u0422\u0432\u043E\u044F \u0430\u0442\u0430\u043A\u0430 \u2014 \u044D\u0442\u043E
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u0447, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043C\u0447\u0438\u0442\u0441\u044F \u0432\u043F\u0435\u0440\u0451\u0434, \u043D\u043E
    \u0438 \u0434\u0443\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435\u0443\u043A\u043B\u043E\u043D\u043D\u043E
    \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F \u043A \u043F\u043E\u0431\u0435\u0434\u0435. "
