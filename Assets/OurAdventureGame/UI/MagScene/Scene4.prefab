  m_text: "\u0414\u043E\u0431\u043B\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u044B\u0446\u0430\u0440\u044C,
    \u0434\u043E\u043B\u0433\u0438\u0435 \u0434\u043D\u0438 \u0438 \u043D\u043E\u0447\u0438
    \u0442\u0432\u043E\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0438\u044F
    \u043F\u0440\u0438\u0448\u043B\u0438 \u043A \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044E.
    \u041F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439 \u0432\u0435\u043B\u0438\u043A\u043E\u0435
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u2014 \u0442\u044B \u0441\u0442\u043E\u0438\u0448\u044C
    \u043B\u0438\u0446\u043E\u043C \u043A \u043B\u0438\u0446\u0443 \u0441 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u0432\u0440\u0430\u0433\u043E\u043C, \u0442\u0435\u043C, \u043A\u0442\u043E
    \u0443\u043A\u0440\u0430\u043B \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
    \u0438 \u043F\u0440\u0438\u043D\u0451\u0441 \u0442\u044C\u043C\u0443 \u043D\u0430
    \u043D\u0430\u0448\u0443 \u0437\u0435\u043C\u043B\u044E."
