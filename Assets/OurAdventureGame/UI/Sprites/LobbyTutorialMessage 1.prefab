  m_text: "\u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u0440\u044B\u0446\u0430\u0440\u044C,
    \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0430\u0439\u0441\u044F \u043A \u0441\u043B\u043E\u0432\u0430\u043C
    \u043C\u043E\u0438\u043C, \u0438\u0431\u043E \u0432\u0435\u043B\u0438\u043A\u0430\u044F
    \u0431\u0435\u0434\u0430 \u043F\u043E\u0441\u0442\u0438\u0433\u043B\u0430 \u043D\u0430\u0448
    \u043C\u0438\u0440. \u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B,
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0430\u0448\u0435\u0439
    \u043C\u0430\u0433\u0438\u0438 \u0438 \u0441\u0438\u043B\u044B, \u0431\u044B\u043B
    \u043F\u043E\u0445\u0438\u0449\u0435\u043D \u0442\u0435\u043C\u043D\u044B\u043C\u0438
    \u0441\u0438\u043B\u0430\u043C\u0438, \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u044F
    \u043D\u0430\u0448 \u043C\u0438\u0440 \u0432\u043E \u0442\u044C\u043C\u0443 \u0438
    \u0431\u0435\u0437\u044B\u0441\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u044C."
